# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Codyssey 교육용 게이트웨이(OpenAI 호환). 개인 OpenAI 키를 쓰면 이 줄을 지우세요.
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5.4-mini
# 답변 1회 최대 토큰 (과금 방지)
OPENAI_MAX_TOKENS=1200
# 한 번의 채팅에서 도구(Function Calling)를 호출할 수 있는 최대 반복 수
MAX_TOOL_ROUNDS=3
# GPT 에 함께 보낼 이전 대화 메시지 수
CHAT_HISTORY_LIMIT=10

# --- Firebase (둘 중 하나만) ---
# 로컬: 다운로드한 서비스 계정 키 파일 경로 (예: ./firebase-key.json — .gitignore 에 포함됨)
FIREBASE_CREDENTIALS_PATH=./firebase-key.json
# 배포(Render): 서비스 계정 JSON 전체를 한 줄 문자열로
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# firestore(기본) | memory(키 없이 로컬 확인용, 재시작 시 초기화)
STORAGE_BACKEND=firestore

# --- CORS: 허용할 프론트엔드 주소 (쉼표로 구분) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- (수집 스크립트 전용) 한국문화정보원 문화 공공데이터광장 서비스 키 — 배포 서버에는 필요 없음 ---
# https://www.culture.go.kr/data 에서 발급 · scripts/import_kcisa.py 가 사용
KCISA_API_KEY=
# (수집 스크립트 전용) 한국문학번역원 번역출간DB / 국립중앙도서관 Open API 키 — scripts/import_bib_apis.py
LTI_API_KEY=
NLK_API_KEY=
