# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# 답변 1회 최대 토큰 (과금 방지)
OPENAI_MAX_TOKENS=900
# 한 번의 채팅에서 도구(Function Calling)를 호출할 수 있는 최대 반복 수
MAX_TOOL_ROUNDS=3
# GPT 에 함께 보낼 이전 대화 메시지 수
CHAT_HISTORY_LIMIT=10

# --- Firebase (둘 중 하나만) ---
# 로컬: 다운로드한 서비스 계정 키 파일 경로 (예: ./firebase-key.json — .gitignore 에 포함됨)
FIREBASE_CREDENTIALS_PATH=./firebase-key.json
# 배포(Render): 서비스 계정 JSON 전체를 한 줄 문자열로
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# firestore(기본) | memory(키 없이 로컬 확인용, 재시작 시 초기화)
STORAGE_BACKEND=firestore

# --- CORS: 허용할 프론트엔드 주소 (쉼표로 구분) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
